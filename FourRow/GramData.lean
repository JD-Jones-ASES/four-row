def representative (k : Fin 131) (p : PermIndex) : ℚ := weights k p - 1

/-- Symmetric product-equality defect; its vanishing is equivalent to constancy
of all same-row and same-column product vectors. -/
def defect (a : Cell → ℝ) : ℝ := ∑ i : Row, ∑ j : Row, ∑ k : Row, ∑ l : Row,
  ((if k = l then 0 else
    (a (cell i k) * a (cell i l) - a (cell j k) * a (cell j l)) ^ 2) +
   (if i = j then 0 else
    (a (cell i k) * a (cell j k) - a (cell i l) * a (cell j l)) ^ 2))

theorem defect_nonneg (a : Cell → ℝ) : 0 ≤ defect a := by
  exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ =>
    Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => by positivity

end FourRow
